{
  "comments": {
    "blockComment": [
      "#",
      "#"
    ],
    "lineComment": "#"
  },
  "brackets": [
    [
      "[",
      "]"
    ],
    [
      "(",
      ")"
    ],
    [
      "{",
      "}"
    ]
  ],
  "autoClosingPairs": [
    {
      "open": "[",
      "close": "]"
    },
    {
      "open": "(",
      "close": ")"
    },
    {
      "open": "{",
      "close": "}"
    },
    {
      "open": "\"",
      "close": "\"",
      "notIn": [
        "string",
        "comment"
      ]
    },
    {
      "open": "#",
      "close": "#",
      "notIn": [
        "string"
      ]
    }
  ],
  "surroundingPairs": [
    [
      "[",
      "]"
    ],
    [
      "(",
      ")"
    ],
    [
      "{",
      "}"
    ],
    [
      "\"",
      "\""
    ],
    [
      "#",
      "#"
    ]
  ],
  "folding": {
    "markers": {
      "start": "^\\s*#\\s*region\\b.*#\\s*$",
      "end": "^\\s*#\\s*endregion\\b.*#\\s*$"
    }
  },
  "indentationRules": {
    "increaseIndentPattern": "^\\s*(fn|if|elif|else|repeat|while|for)\\b(?!.*\\bend\\b).*$",
    "decreaseIndentPattern": "^\\s*(elif|else|end)\\b.*$"
  }
}
