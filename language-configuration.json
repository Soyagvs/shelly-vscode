{
  "comments": {
    "blockComment": [
      "#",
      "#"
    ],
    "lineComment": "#"
  },
  "brackets": [
    [
      "[",
      "]"
    ],
    [
      "(",
      ")"
    ],
    [
      "{",
      "}"
    ]
  ],
  "autoClosingPairs": [
    {
      "open": "[",
      "close": "]"
    },
    {
      "open": "(",
      "close": ")"
    },
    {
      "open": "{",
      "close": "}"
    },
    {
      "open": "\"",
      "close": "\"",
      "notIn": [
        "string",
        "comment"
      ]
    },
    {
      "open": "#",
      "close": "#",
      "notIn": [
        "string"
      ]
    }
  ],
  "surroundingPairs": [
    [
      "[",
      "]"
    ],
    [
      "(",
      ")"
    ],
    [
      "{",
      "}"
    ],
    [
      "\"",
      "\""
    ],
    [
      "#",
      "#"
    ]
  ],
  "folding": {
    "markers": {
      "start": "^\\s*#\\s*region\\b.*#\\s*$",
      "end": "^\\s*#\\s*endregion\\b.*#\\s*$"
    }
  },
  "indentationRules": {
    "increaseIndentPattern": "^\\s*(?:\\bfn\\b|\\bif\\b|\\belif\\b|\\belse\\b|\\brepeat\\b|\\bwhile\\b|\\bfor\\b|\\btry\\b|\\bcatch\\b|\\bcase\\b|\\bwhen\\b|\\blog\\b)(?!.*\\bend\\b).*$",
    "decreaseIndentPattern": "^\\s*(elif|else|end)\\b.*$"
  }
}
