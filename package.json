{
  "name": "shelly-language-oficial",
  "displayName": "Shelly Language Oficial",
  "description": "VS Code language support for Shelly .shelly scripts.",
  "version": "0.0.6",
  "publisher": "AGUSTINGABRIELMARTINEZ",
  "icon": "icons/shelly.png",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Soyagvs/shelly-vscode.git"
  },
  "bugs": {
    "url": "https://github.com/Soyagvs/shelly-vscode/issues"
  },
  "homepage": "https://github.com/Soyagvs/shelly-vscode#readme",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "keywords": [
    "shelly",
    "language",
    "syntax",
    "highlighting"
  ],
  "files": [
    "language-configuration.json",
    "syntaxes/shelly.tmLanguage.json",
    "src/extension.js",
    "README.md",
    "LICENSE",
    "icons/shelly.svg",
    "icons/shelly.png",
    "icon-themes/shelly-icon-theme.json"
  ],
  "scripts": {
    "package": "npx @vscode/vsce package --no-dependencies",
    "compile": "npm run build",
    "build": "node --check src/extension.js",
    "validate": "node -e \"JSON.parse(require('fs').readFileSync('package.json','utf8')); JSON.parse(require('fs').readFileSync('syntaxes/shelly.tmLanguage.json','utf8'))\""
  },
  "devDependencies": {
    "@vscode/vsce": "^4.0.0"
  },
  "contributes": {
    "languages": [
      {
        "id": "shelly",
        "aliases": [
          "Shelly"
        ],
        "extensions": [
          ".shelly"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "shelly",
        "scopeName": "source.shelly",
        "path": "./syntaxes/shelly.tmLanguage.json"
      }
    ],
    "iconThemes": [
      {
        "id": "shelly-icons",
        "label": "Shelly Icons",
        "path": "./icon-themes/shelly-icon-theme.json"
      }
    ]
  },
  "main": "./src/extension.js",
  "activationEvents": [
    "onLanguage:shelly"
  ]
}
