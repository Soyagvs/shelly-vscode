{
  "name": "shelly-language-oficial",
  "displayName": "Shelly Language Oficial",
  "description": "VS Code language support for Shelly .shelly scripts.",
  "version": "0.1.0",
  "publisher": "AGUSTINGABRIELMARTINEZ",
  "icon": "icons/shelly.png",
  "license": "GPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "https://github.com/Soyagvs/shelly-vscode.git"
  },
  "bugs": {
    "url": "https://github.com/Soyagvs/shelly-vscode/issues"
  },
  "homepage": "https://github.com/Soyagvs/shelly-vscode#readme",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "keywords": [
    "shelly",
    "language",
    "syntax",
    "highlighting"
  ],
  "files": [
    "language-configuration.json",
    "syntaxes/shelly.tmLanguage.json",
    "src/extension.js",
    "src/client.js",
    "node_modules/vscode-languageclient/**",
    "node_modules/vscode-languageserver-protocol/**",
    "node_modules/vscode-languageserver-types/**",
    "node_modules/vscode-jsonrpc/**",
    "node_modules/semver/**",
    "README.md",
    "LICENSE",
    "icons/shelly.svg",
    "icons/shelly.png",
    "icon-themes/shelly-icon-theme.json"
  ],
  "scripts": {
    "package": "npx @vscode/vsce package",
    "verify-package": "node -e \"const cp=require('child_process'); const archive='shelly-language-oficial-0.1.0.vsix'; const files=cp.execFileSync('unzip',['-Z1',archive],{encoding:'utf8'}).trim().split(/\\r?\\n/); const required=['extension/src/client.js','extension/node_modules/vscode-languageclient/lib/node/main.js','extension/node_modules/vscode-languageserver-protocol/lib/common/api.js']; const missing=required.filter((file)=>!files.includes(file)); if(missing.length){console.error('Missing VSIX files: '+missing.join(', ')); process.exit(1)} console.log('Verified VSIX files: '+required.join(', '));\"",
    "compile": "npm run build",
    "build": "node --check src/extension.js",
    "validate": "node -e \"JSON.parse(require('fs').readFileSync('package.json','utf8')); JSON.parse(require('fs').readFileSync('syntaxes/shelly.tmLanguage.json','utf8'))\"",
    "test": "node --test test/**/*.test.js"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "@vscode/vsce": "^4.0.0"
  },
  "contributes": {
    "configuration": {
      "title": "Shelly",
      "properties": {
        "shelly.serverPath": {
          "type": "string",
          "default": "shelly-lsp",
          "description": "Path or command used to start the Shelly language server."
        }
      }
    },
    "languages": [
      {
        "id": "shelly",
        "aliases": [
          "Shelly"
        ],
        "extensions": [
          ".shelly"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "shelly",
        "scopeName": "source.shelly",
        "path": "./syntaxes/shelly.tmLanguage.json"
      }
    ],
    "iconThemes": [
      {
        "id": "shelly-icons",
        "label": "Shelly Icons",
        "path": "./icon-themes/shelly-icon-theme.json"
      }
    ]
  },
  "main": "./src/extension.js",
  "activationEvents": [
    "onLanguage:shelly"
  ]
}
