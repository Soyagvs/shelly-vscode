{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Shelly",
  "scopeName": "source.shelly",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#blockOutput"
    },
    {
      "include": "#table"
    },
    {
      "include": "#measure"
    },
    {
      "include": "#functionNames"
    },
    {
      "include": "#http"
    },
    {
      "include": "#archive"
    },
    {
      "include": "#menu"
    },
    {
      "include": "#mock"
    },
    {
      "include": "#dictionaryKeys"
    },
    {
      "include": "#constants"
    },
    {
      "include": "#variables"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#commands"
    },
    {
      "include": "#predicates"
    },
    {
      "include": "#booleans"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#arrows"
    },
    {
      "include": "#regexLiterals"
    },
    {
      "include": "#operators"
    },
    {
      "include": "#selectors"
    },
    {
      "include": "#brackets"
    },
    {
      "include": "#punctuation"
    }
  ],
  "repository": {
    "blockOutput": {
      "patterns": [
        {
          "name": "meta.block.output.shelly",
          "match": "(->)(\\s*)(\\$[A-Za-z][A-Za-z0-9_]*(?:\\[[^\\]\\r\\n]*\\]|\\.[A-Za-z][A-Za-z0-9_]*)*)",
          "captures": {
            "1": {
              "name": "keyword.operator.arrow.shelly"
            },
            "3": {
              "name": "variable.other.shelly"
            }
          }
        }
      ]
    },
    "comments": {
      "patterns": [
        {
          "name": "comment.block.number-sign.shelly",
          "begin": "#",
          "end": "#",
          "patterns": []
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.triple-backtick.shelly",
          "begin": "```",
          "end": "```",
          "patterns": [
            {
              "name": "variable.other.interpolation.shelly",
              "match": "\\$[A-Za-z][A-Za-z0-9_]*(?:\\[[^\\]\\r\\n]*\\]|\\.[A-Za-z][A-Za-z0-9_]*)*"
            }
          ]
        },
        {
          "name": "string.quoted.double.shelly",
          "begin": "\\\"",
          "end": "\\\"",
          "patterns": [
            {
              "name": "constant.character.escape.shelly",
              "match": "\\\\(?:[\\\\\\\"nrt]|x[0-9A-Fa-f]{2}|u\\{[0-9A-Fa-f]+\\})"
            },
            {
              "name": "variable.other.interpolation.shelly",
              "match": "\\$[A-Za-z][A-Za-z0-9_]*(?:\\[[^\\]\\r\\n]*\\]|\\.[A-Za-z][A-Za-z0-9_]*)*"
            }
          ]
        }
      ]
    },
    "table": {
      "patterns": [
        {
          "name": "meta.table.shelly",
          "begin": "^\\s*table\\b",
          "end": "^\\s*end\\b",
          "patterns": [
            {
              "include": "#comments"
            },
            {
              "include": "#strings"
            },
            {
              "include": "#controlFlow"
            },
            {
              "include": "#variables"
            },
            {
              "name": "support.function.table.command.shelly",
              "match": "(?<![$A-Za-z0-9_])(?:column|row|footer|border)(?![A-Za-z0-9_])"
            },
            {
              "name": "constant.language.table.border.shelly",
              "match": "(?<![$A-Za-z0-9_])(?:ascii|unicode|rounded)(?![A-Za-z0-9_])"
            }
          ]
        }
      ]
    },
    "measure": {
      "patterns": [
        {
          "name": "meta.measure.shelly",
          "begin": "^\\s*measure\\s*->\\s*\\$milliseconds\\b",
          "end": "^\\s*end\\b",
          "patterns": [
            {
              "include": "#comments"
            },
            {
              "include": "#strings"
            },
            {
              "include": "#controlFlow"
            },
            {
              "include": "#variables"
            }
          ]
        }
      ]
    },
    "controlFlow": {
      "patterns": [
        {
          "include": "#comments"
        },
        {
          "include": "#strings"
        },
        {
          "name": "keyword.control.shelly",
          "match": "\\b(?:fn|end|if|elif|else|case|when|repeat|while|for|in|try|catch|retry|pipeline|parallel|log|call|return|break|continue|and|or|not|global|export|import|include|exit)\\b"
        }
      ]
    },
    "archive": {
      "patterns": [
        {
          "name": "support.function.archive.shelly",
          "begin": "(?<![$A-Za-z0-9_])archive(?![A-Za-z0-9_])",
          "end": "(?=\\r?$)",
          "patterns": [
            {
              "include": "#comments"
            },
            {
              "include": "#strings"
            },
            {
              "name": "support.function.archive.subcommand.shelly",
              "match": "(?<![$A-Za-z0-9_])(?:create|extract|checksum|check)(?![A-Za-z0-9_])"
            },
            {
              "name": "support.type.property-name.archive.shelly",
              "match": "(?<![$A-Za-z0-9_])(?:from|into)(?![A-Za-z0-9_])"
            },
            {
              "include": "#variables"
            }
          ]
        }
      ]
    },
    "menu": {
      "patterns": [
        {
          "name": "meta.menu.shelly",
          "begin": "^\\s*menu\\b",
          "end": "^\\s*end\\b",
          "patterns": [
            {
              "include": "#comments"
            },
            {
              "name": "support.function.menu.command.shelly",
              "match": "^\\s+(?:keys\\s+(?:numbers|letters\\s+(?:lower|upper))|option(?:\\[[^\\]\\r\\n]+\\])?\\s+\\\"[^\\\"\\r\\n]*\\\"|shellout\\s+\\\"\\\")\\s*$"
            },
            {
              "include": "#strings"
            }
          ]
        }
      ]
    },
    "mock": {
      "patterns": [
        {
          "name": "support.function.mock.shelly",
          "begin": "(?<![$A-Za-z0-9_])(?:mock|secret)(?![A-Za-z0-9_])",
          "end": "(?=\\r?$)",
          "patterns": [
            {
              "include": "#comments"
            },
            {
              "include": "#strings"
            },
            {
              "name": "support.function.mock.subcommand.shelly",
              "match": "(?<![$A-Za-z0-9_])(?:get|set|call|event|notify)(?![A-Za-z0-9_])"
            },
            {
              "name": "keyword.control.mock.returns.shelly",
              "match": "(?<![$A-Za-z0-9_])returns(?![A-Za-z0-9_])"
            },
            {
              "include": "#variables"
            }
          ]
        }
      ]
    },
    "http": {
      "patterns": [
        {
          "name": "support.function.http.shelly",
          "match": "(?<![$A-Za-z0-9_])http(?![A-Za-z0-9_])|(?<![$A-Za-z0-9_.])(?:GET|POST|PUT|PATCH|DELETE|HEAD|OPTIONS)(?![A-Za-z0-9_])"
        },
        {
          "name": "support.type.property-name.http.shelly",
          "match": "(?<![$A-Za-z0-9_])(?:headers|body|timeout|maxBytes|httpPages|maxPages|maxTotalBytes)(?=\\s*:)(?![A-Za-z0-9_])"
        }
      ]
    },
    "functionNames": {
      "patterns": [
        {
          "name": "entity.name.function.shelly",
          "match": "(?<=\\bfn\\s)[A-Za-z_][A-Za-z0-9_]*"
        }
      ]
    },
    "dictionaryKeys": {
      "patterns": [
        {
          "name": "support.type.property-name.shelly",
          "match": "\\b[A-Za-z_][A-Za-z0-9_]*(?=\\s*:)"
        }
      ]
    },
    "variables": {
      "patterns": [
        {
          "name": "variable.other.shelly",
          "match": "\\$[a-z][A-Za-z0-9_]*(?:\\[[^\\]\\r\\n]*\\]|\\.[A-Za-z][A-Za-z0-9_]*)*\\b"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.shelly",
          "match": "\\b(?:fn|end|if|elif|else|case|when|repeat|while|for|in|try|catch|retry|pipeline|parallel|log|call|return|break|continue|and|or|not|global|export|import|include|exit)\\b"
        }
      ]
    },
    "commands": {
      "patterns": [
        {
          "name": "support.function.command.shelly",
          "match": "\\b(?:shell|shellin|ask|clear|progress|arg|args|files|create|copy|move|rename|remove|read|write|append|prepend|tempFile|tempDir|trim|lower|upper|replace|split|join|sort|reverse|unique|substring|padLeft|padRight|toNumber|toString|values|jsonParse|jsonStringify|basename|dirname|extension|withoutExtension|now|today|formatDate|random|randomInt|watch|wait)\\b"
        }
      ]
    },
    "predicates": {
      "patterns": [
        {
          "name": "support.function.predicate.shelly",
          "match": "\\b(?:hasArg|exists|contains|isFile|isDir|startsWith|endsWith|len|isEmpty|isNumber|isText|isList|isDict|matches)\\b"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.shelly",
          "match": "\\$[A-Z][A-Z0-9_]*\\b"
        }
      ]
    },
    "booleans": {
      "patterns": [
        {
          "name": "constant.language.boolean.shelly",
          "match": "\\b(?:true|false)\\b"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.shelly",
          "match": "(?<![A-Za-z0-9_])-?(?:\\d+\\.\\d+|\\d+)(?![A-Za-z0-9_])"
        }
      ]
    },
    "regexLiterals": {
      "patterns": [
        {
          "name": "string.regexp.shelly",
          "match": "/(?:\\\\.|\\[[^\\]\\r\\n]*\\]|[^/\\\\[\\r\\n])+/"
        }
      ]
    },
    "arrows": {
      "patterns": [
        {
          "name": "keyword.operator.arrow.shelly",
          "match": "->"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.shelly",
          "match": "==|!=|>=|<=|\\.\\.|[=+*/<>-]"
        }
      ]
    },
    "selectors": {
      "patterns": [
        {
          "name": "meta.selector.list.shelly",
          "begin": "\\[",
          "end": "\\]",
          "patterns": [
            {
              "include": "#strings"
            },
            {
              "include": "#variables"
            },
            {
              "include": "#numbers"
            },
            {
              "include": "#booleans"
            },
            {
              "include": "#operators"
            },
            {
              "name": "constant.language.selector.shelly",
              "match": "\\b(?:first|last)\\b"
            }
          ]
        }
      ]
    },
    "brackets": {
      "patterns": [
        {
          "name": "punctuation.definition.bracket.shelly",
          "match": "[\\[\\]{}()]"
        }
      ]
    },
    "punctuation": {
      "patterns": [
        {
          "name": "punctuation.separator.shelly",
          "match": "[,;:]"
        },
        {
          "name": "punctuation.accessor.shelly",
          "match": "\\."
        }
      ]
    }
  }
}
