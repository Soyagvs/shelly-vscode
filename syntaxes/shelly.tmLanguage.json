{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Shelly",
  "scopeName": "source.shelly",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#functionNames"
    },
    {
      "include": "#dictionaryKeys"
    },
    {
      "include": "#variables"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#builtins"
    },
    {
      "include": "#booleans"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#arrows"
    },
    {
      "include": "#operators"
    },
    {
      "include": "#selectors"
    },
    {
      "include": "#brackets"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.block.number-sign.shelly",
          "begin": "#",
          "end": "#",
          "patterns": []
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.triple-backtick.shelly",
          "begin": "```",
          "end": "```",
          "patterns": [
            {
              "name": "variable.other.interpolation.shelly",
              "match": "\\$[A-Za-z][A-Za-z0-9_]*(?:\\[[^\\]\\r\\n]*\\]|\\.[A-Za-z][A-Za-z0-9_]*)*"
            }
          ]
        },
        {
          "name": "string.quoted.double.shelly",
          "begin": "\\\"",
          "end": "\\\"",
          "patterns": [
            {
              "name": "constant.character.escape.shelly",
              "match": "\\\\(?:[\\\\\\\"nrt]|x[0-9A-Fa-f]{2}|u\\{[0-9A-Fa-f]+\\})"
            },
            {
              "name": "variable.other.interpolation.shelly",
              "match": "\\$[A-Za-z][A-Za-z0-9_]*(?:\\[[^\\]\\r\\n]*\\]|\\.[A-Za-z][A-Za-z0-9_]*)*"
            }
          ]
        }
      ]
    },
    "functionNames": {
      "patterns": [
        {
          "name": "entity.name.function.shelly",
          "match": "(?<=\\bfn\\s)[A-Za-z_][A-Za-z0-9_]*"
        }
      ]
    },
    "dictionaryKeys": {
      "patterns": [
        {
          "name": "support.type.property-name.shelly",
          "match": "\\b[A-Za-z_][A-Za-z0-9_]*(?=\\s*:)"
        }
      ]
    },
    "variables": {
      "patterns": [
        {
          "name": "variable.other.shelly",
          "match": "\\$[A-Za-z][A-Za-z0-9_]*(?:\\[[^\\]\\r\\n]*\\]|\\.[A-Za-z][A-Za-z0-9_]*)*\\b"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.shelly",
          "match": "\\b(?:fn|end|if|elif|else|case|when|repeat|while|for|in|try|catch|log|call|return|break|continue|and|or|not|global|export|import|include|exit)\\b"
        }
      ]
    },
    "builtins": {
      "patterns": [
        {
          "name": "support.function.builtin.shelly",
          "match": "\\bshell\\b|\\bshellin\\b|\\b(?:shellout|ask|choose|command|arg|hasArg|args|exists|contains|files|create|copy|move|rename|remove|read|write|append|prepend|isFile|isDir|tempFile|tempDir|size|trim|lower|upper|replace|split|startsWith|endsWith|len|join|sort|reverse|unique|substring|padLeft|padRight|toNumber|toString|isEmpty|isNumber|isText|isList|isDict|keys|values|jsonParse|jsonStringify|basename|dirname|extension|withoutExtension|now|today|formatDate|random|randomInt)\\b"
        }
      ]
    },
    "booleans": {
      "patterns": [
        {
          "name": "constant.language.boolean.shelly",
          "match": "\\b(?:true|false)\\b"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.shelly",
          "match": "(?<![A-Za-z0-9_])[-+]?(?:\\d+\\.\\d+|\\d+)(?![A-Za-z0-9_])"
        }
      ]
    },
    "arrows": {
      "patterns": [
        {
          "name": "keyword.operator.arrow.shelly",
          "match": "->"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.shelly",
          "match": "==|!=|>=|<=|\\.\\.|[=+*/<>-]"
        }
      ]
    },
    "selectors": {
      "patterns": [
        {
          "name": "meta.selector.list.shelly",
          "begin": "\\[",
          "end": "\\]",
          "patterns": [
            {
              "include": "#strings"
            },
            {
              "include": "#variables"
            },
            {
              "include": "#numbers"
            },
            {
              "include": "#booleans"
            },
            {
              "include": "#operators"
            },
            {
              "name": "constant.language.selector.shelly",
              "match": "\\b(?:first|last)\\b"
            }
          ]
        }
      ]
    },
    "brackets": {
      "patterns": [
        {
          "name": "punctuation.definition.bracket.shelly",
          "match": "[\\[\\]{}()]"
        }
      ]
    }
  }
}
